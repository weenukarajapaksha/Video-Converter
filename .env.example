# --- Required -------------------------------------------------------------
# Google AI Studio key: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Hugging Face token with access to pyannote/speaker-diarization-3.1
# (accept the model terms at https://hf.co/pyannote/speaker-diarization-3.1
#  and https://hf.co/pyannote/segmentation-3.0)
HF_TOKEN=

